PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mehta_electronics_local?sslmode=require
TALLY_CONNECTOR_ORG_ID=mehta-electronics
TALLY_STALLED_RUN_MINUTES=30
TALLY_FINANCIAL_ROLES=OWNER,ACCOUNTS
SESSION_TTL_MINUTES=480
TALLY_URL=http://127.0.0.1:9000
TALLY_COMPANY=Mehta Electronics
TALLY_TIMEOUT_MS=10000
TALLY_MAX_RETRIES=3
COMPANY_NAME=Mehta Electronics
COMPANY_ADDRESS=Your business address
COMPANY_GSTIN=
COMPANY_EMAIL=sales@example.com
COMPANY_PHONE=
# Displayed on Incoming requests; does not enable email receiving.
BUSINESS_INBOX_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Two-factor sign-in. Development may use password-only login.
# Production refuses startup unless MFA_ENABLED=true and a valid encryption key is configured.
MFA_ENABLED=false
# Encrypts two-factor (TOTP) secrets at rest; needed only when MFA_ENABLED=true. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Background jobs (SLA escalation, task reminders, record sync). Their automation switches still start OFF.
SCHEDULER_ENABLED=true

# Read-only comparison of explicitly selected stored orders; no Tally writes.
TALLY_ORDER_COMPARISON_ENABLED=false
