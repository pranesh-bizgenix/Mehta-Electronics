FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
RUN npm ci --prefix apps/web
COPY src ./src
COPY public ./public
COPY database ./database
COPY scripts/lib/price-pdf-table.py ./scripts/lib/price-pdf-table.py
COPY apps/web ./apps/web
RUN npm --prefix apps/web run build

FROM node:24-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && python3 -m venv /opt/pdf-tools \
    && /opt/pdf-tools/bin/pip install --no-cache-dir pypdf==6.14.2 \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/pdf-tools/bin:${PATH}"
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node", "src/server.js"]
